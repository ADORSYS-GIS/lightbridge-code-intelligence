{
  "$schema": "https://opencode.ai/config.json",
  // Points opencode at the REAL eaig OpenAI-compatible gateway to close RFC-0009 probe item (c):
  // reasoning fidelity — does per-turn reasoning survive the eaig path and reach our recorder as
  // `reasoning.part` (ADR-0060 requirement) and the ACP client as thought chunks?
  //
  // ⚠️ RUN THIS IN YOUR ENVIRONMENT — eaig is internal (HTTPS + a mounted CA), unreachable from the
  // build sandbox, so this could not be verified here. Set before running (see run-eaig-reasoning.sh):
  //   LCI_EAIG_BASE_URL   the eaig chat-completions base, e.g. https://eaig.internal/.../v1
  //   LCI_EAIG_API_KEY    the gateway key
  //   LCI_EAIG_MODEL      a REASONING-capable chat model id served by eaig
  //   NODE_EXTRA_CA_CERTS the mounted internal CA bundle (so opencode trusts the eaig HTTPS)
  //
  // The model KEY is a fixed alias `reasoner`; the real upstream id rides the model `id` field
  // (env-substituted, like the other {env:} strings), so no env interpolation in a JSON key is needed.
  "provider": {
    "eaig": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "eaig",
      "options": {
        "baseURL": "{env:LCI_EAIG_BASE_URL}",
        "apiKey": "{env:LCI_EAIG_API_KEY}"
      },
      "models": {
        "reasoner": {
          "id": "{env:LCI_EAIG_MODEL}",
          "name": "eaig reasoner",
          "reasoning": true
        }
      }
    }
  },
  "model": "eaig/reasoner",
  // Only the recorder + logger are needed for item (c) — this is a reasoning-capture check, not the
  // gate/tool loop (that's the offline sim). Absolute /opt paths match the built image.
  "plugin": [
    "/opt/lightbridge/opencode/plugins/recorder/src/index.ts",
    "/opt/lightbridge/opencode/plugins/logger/src/index.ts"
  ],
  "agent": {
    "reasoner": {
      "mode": "primary",
      "description": "Reasoning-fidelity probe agent: thinks step by step, then answers.",
      "prompt": "Reason step by step, showing your thinking, then give a one-line answer."
    }
  }
}

  <mxGeometry relative="1" as="geometry" />
</mxCell>
<mxCell id="n130" value="a2a_task_id" style="html=1;endArrow=block;endFill=1;strokeColor=#94a3b8;strokeWidth=1.2;fontColor=#e2e8f0;fontFamily=Helvetica;fontSize=9;labelBackgroundColor=#000000;" edge="1" parent="1" source="n128" target="n125">
  <mxGeometry relative="1" as="geometry" />
</mxCell>
<mxCell id="n131" value="Execution state (RFC-0005) — deliberately bare task_id, no FK" style="text;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#94a3b8;align=left;" vertex="1" parent="1">
  <mxGeometry x="1360" y="670" width="600" height="28" as="geometry" />
</mxCell>
<mxCell id="n133" value="pr_open_blob&#10;Content-hashed branch patch for the dormant &#x27;open&#x27; mode&#x27;s mediated PR-open egress." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
  <mxGeometry x="1360" y="792" width="230" height="64" as="geometry" />
</mxCell>
<mxCell id="n134" value="org_model_overrides&#10;One row per installation (org). NOT FK&#x27;d — an installation may precede any repo row." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
  <mxGeometry x="720" y="580" width="230" height="64" as="geometry" />
</mxCell>
<mxCell id="n135" value="B. Postgres + pgvector — semantic store (same Postgres instance, not a separate server)" style="text;html=1;fontFamily=Helvetica;fontSize=17;fontStyle=1;fontColor=#ffffff;align=left;" vertex="1" parent="1">
  <mxGeometry x="60" y="940" width="1100" height="28" as="geometry" />
</mxCell>
<mxCell id="n136" value="code_chunks&#10;One row per semantic unit (function/class/...) or windowed fallback: file_path, language, content (text), embedding vector(4096). Exact cosine scan, scoped to (repository_id, commit_sha) — no ANN index, 4096 exceeds pgvector&#x27;s HNSW limit." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=11;strokeWidth=2;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
  <mxGeometry x="60" y="990" width="420" height="110" as="geometry" />
</mxCell>
<mxCell id="n137" value="repository_id" style="html=1;endArrow=block;endFill=1;strokeColor=#94a3b8;strokeWidth=1.2;fontColor=#e2e8f0;fontFamily=Helvetica;fontSize=9;labelBackgroundColor=#000000;" edge="1" parent="1" source="n136" target="n102">
  <mxGeometry relative="1" as="geometry" />
</mxCell>
<mxCell id="n138" value="C. Neo4j — structural graph (a different database entirely)" style="text;html=1;fontFamily=Helvetica;fontSize=17;fontStyle=1;fontColor=#ffffff;align=left;" vertex="1" parent="1">
  <mxGeometry x="60" y="1130" width="1000" height="28" as="geometry" />
</mxCell>
<mxCell id="n139" value=":Symbol&#10;repo_id, commit, node_id, label, source_file, start_line, embedding (optional, pgvector-independent copy for graph-local similarity)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=11;strokeWidth=2;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
  <mxGeometry x="60" y="1180" width="320" height="100" as="geometry" />
</mxCell>
<mxCell id="n140" value=":Symbol&#10;A second symbol node -- e.g. the function being called." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
  <mxGeometry x="580" y="1180" width="280" height="100" as="geometry" />
</mxCell>
<mxCell id="n141" value="[:REL {relation: &quot;calls&quot;}]" style="html=1;endArrow=block;endFill=1;strokeColor=#94a3b8;strokeWidth=1.2;fontColor=#e2e8f0;fontFamily=Helvetica;fontSize=9;labelBackgroundColor=#000000;" edge="1" parent="1" source="n139" target="n140">
  <mxGeometry relative="1" as="geometry" />
</mxCell>
<mxCell id="n142" value="One generic node label (:Symbol) and one generic relationship type (:REL) -- Cypher can&#x27;t parameterize a relationship TYPE, so the actual kind (calls/implements/imports/...) is a property value." style="text;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#94a3b8;align=left;" vertex="1" parent="1">
  <mxGeometry x="60" y="1300" width="900" height="28" as="geometry" />
</mxCell>


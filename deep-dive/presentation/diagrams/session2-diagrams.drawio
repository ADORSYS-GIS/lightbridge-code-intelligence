        <mxCell id="ae7" style="html=1;endArrow=block;endFill=1;strokeColor=#94a3b8;strokeWidth=1.5;" edge="1" parent="1" source="a5" target="a7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="anote" value="Each role is deployed as its own Kubernetes Deployment off the SAME image — they scale independently." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#64748b;fontColor=#cbd5e1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="60" y="320" width="500" height="80" as="geometry" />
        </mxCell>

        <mxCell id="titleB" value="B. Claiming the queue — a real race, resolved by Postgres" style="text;html=1;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#ffffff;align=left;" vertex="1" parent="1">
          <mxGeometry x="1560" y="55" width="620" height="28" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="N dispatcher replicas,&#10;same SELECT ... LIMIT 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1560" y="140" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="bd" value="Row already locked by&#10;another replica?" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1870" y="110" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="SKIP LOCKED --&#10;try the next row instead" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#94a3b8;fontColor=#cbd5e1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1870" y="300" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="UPDATE status='running',&#10;lease_owner, lease_expires_at&#10;-- this replica owns it" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1560" y="400" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="be0" style="html=1;endArrow=block;endFill=1;strokeColor=#94a3b8;strokeWidth=1.5;" edge="1" parent="1" source="b1" target="bd">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="be1" value="YES" style="html=1;endArrow=block;endFill=1;strokeColor=#94a3b8;strokeWidth=1.5;fontColor=#e2e8f0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#000000;" edge="1" parent="1" source="bd" target="b2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="be2" value="NO -- claim it" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#94a3b8;strokeWidth=1.5;fontColor=#e2e8f0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#000000;exitX=0.3;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="bd" target="b3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="titleD" value="C. Structural or semantic? Two stores, one decision" style="text;html=1;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#ffffff;align=left;" vertex="1" parent="1">
          <mxGeometry x="1200" y="620" width="620" height="28" as="geometry" />
        </mxCell>
        <mxCell id="dd" value="What kind of question&#10;is this?" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1200" y="680" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="&quot;What calls this?&quot;&#10;Neo4j -- exact relationships" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1560" y="665" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="&quot;Where is something&#10;like this?&quot; pgvector --&#10;semantic similarity" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1560" y="760" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="de1" value="structural" style="html=1;endArrow=block;endFill=1;strokeColor=#94a3b8;strokeWidth=1.5;fontColor=#e2e8f0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#000000;" edge="1" parent="1" source="dd" target="d1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de2" value="semantic" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#94a3b8;strokeWidth=1.5;fontColor=#e2e8f0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#000000;exitX=0.7;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="dd" target="d2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="titleE" value="D. Hybrid search — fused into one ranked result" style="text;html=1;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#ffffff;align=left;" vertex="1" parent="1">
          <mxGeometry x="700" y="1040" width="600" height="28" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="search by name" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="700" y="1100" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="search by meaning" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="700" y="1190" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="fused and ranked" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1020" y="1145" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="one ranked result" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1340" y="1145" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ee1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#94a3b8;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="e1" target="e3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ee2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#94a3b8;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.7;" edge="1" parent="1" source="e2" target="e3">
          <mxGeometry relative="1" as="geometry" />

        <mxCell id="f1" value="K8s Job starts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">

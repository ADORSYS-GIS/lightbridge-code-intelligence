  <mxGeometry relative="1" as="geometry" />
</mxCell>
<mxCell id="n109" value="repository_id" style="html=1;endArrow=block;endFill=1;strokeColor=#94a3b8;strokeWidth=1.2;fontColor=#e2e8f0;fontFamily=Helvetica;fontSize=9;labelBackgroundColor=#000000;" edge="1" parent="1" source="n105" target="n102">
  <mxGeometry relative="1" as="geometry" />
</mxCell>
<mxCell id="n110" value="repository_id" style="html=1;endArrow=block;endFill=1;strokeColor=#94a3b8;strokeWidth=1.2;fontColor=#e2e8f0;fontFamily=Helvetica;fontSize=9;labelBackgroundColor=#000000;" edge="1" parent="1" source="n106" target="n102">
  <mxGeometry relative="1" as="geometry" />
</mxCell>
<mxCell id="n111" value="webhook_deliveries&#10;One row per inbound webhook (dedup key). repository_id is informational, NOT a foreign key." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
  <mxGeometry x="390" y="480" width="230" height="64" as="geometry" />
</mxCell>
<mxCell id="n112" value="repository_id (no FK)" style="html=1;endArrow=block;endFill=1;strokeColor=#94a3b8;strokeWidth=1.2;dashed=1;fontColor=#e2e8f0;fontFamily=Helvetica;fontSize=9;labelBackgroundColor=#000000;" edge="1" parent="1" source="n111" target="n102">
  <mxGeometry relative="1" as="geometry" />
</mxCell>
<mxCell id="n113" value="tasks&#10;One run: target (PR/issue), command, status, timing, indexed_sha, model_override." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=11;strokeWidth=2;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
  <mxGeometry x="720" y="120" width="250" height="80" as="geometry" />
</mxCell>

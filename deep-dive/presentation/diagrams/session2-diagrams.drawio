  <mxGeometry relative="1" as="geometry" />
</mxCell>
<mxCell id="n115" value="outbox&#10;One row per intent to write the forge (review/reply/reaction/label/pr_open). Sole egress — reconciler-drained." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
  <mxGeometry x="1050" y="120" width="260" height="64" as="geometry" />
</mxCell>
<mxCell id="n116" value="reviews&#10;Persisted copy of the posted review (summary, body, findings[]). PK = task_id (1:1, upserted on re-post)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
  <mxGeometry x="1050" y="210" width="260" height="64" as="geometry" />
</mxCell>
<mxCell id="n117" value="review_comments&#10;The platform comment ids a review created, so the reaction poller knows what to poll." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
  <mxGeometry x="1050" y="300" width="260" height="64" as="geometry" />
</mxCell>
<mxCell id="n118" value="review_feedback&#10;One reaction on one of our comments, reconciled each poll cycle." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
  <mxGeometry x="1050" y="390" width="260" height="64" as="geometry" />
</mxCell>
<mxCell id="n119" value="pending_review_actions&#10;The agent&#x27;s mediated write-tool buffer (inline/comment/summary). Flushed once at finalize, UNvalidated." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
  <mxGeometry x="1050" y="480" width="260" height="64" as="geometry" />
</mxCell>

        <mxCell id="ee3" style="html=1;endArrow=block;endFill=1;strokeColor=#94a3b8;strokeWidth=1.5;" edge="1" parent="1" source="e3" target="e4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="titleF" value="E. Keeping the index bounded" style="text;html=1;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#ffffff;align=left;" vertex="1" parent="1">
          <mxGeometry x="1860" y="510" width="330" height="28" as="geometry" />
        </mxCell>
        <mxCell id="fd" value="in the keep-set?&#10;latest indexed OR any&#10;in-flight task head" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1870" y="555" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="f1" value="YES -- kept" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1870" y="715" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="NO -- pruned from&#10;pgvector + Neo4j&#10;(index sweeper, every 10 min)" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#94a3b8;fontColor=#cbd5e1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1870" y="815" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="fe1" value="YES" style="html=1;endArrow=block;endFill=1;strokeColor=#94a3b8;strokeWidth=1.5;fontColor=#e2e8f0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#000000;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="fd" target="f1">
          <mxGeometry relative="1" as="geometry" />

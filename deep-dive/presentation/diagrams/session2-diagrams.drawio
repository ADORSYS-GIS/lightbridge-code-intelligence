<mxfile host="app.diagrams.net">
  <diagram name="1 - Control Plane" id="cp-roles">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1250" math="0" shadow="0" background="#000000">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="titleA" value="A. One binary, many roles — the real dispatch" style="text;html=1;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#ffffff;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="55" width="600" height="28" as="geometry" />
        </mxCell>
        <mxCell id="a0" value="CONTROL_PLANE_ROLE&#10;(or first CLI arg)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ad" value="match role.as_str()?" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="340" y="100" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="serve&#10;HTTP API, webhooks" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="680" y="40" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="dispatcher&#10;claims queue, launches Jobs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="680" y="130" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="reconciler (poller)&#10;sole write egress -- all platforms" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="680" y="220" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="a2a&#10;Agent2Agent ingress" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="950" y="40" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="notifier&#10;A2A push webhooks" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="950" y="130" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="mcp&#10;MCP server for external clients" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1220" y="135" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ae0" style="html=1;endArrow=block;endFill=1;strokeColor=#94a3b8;strokeWidth=1.5;" edge="1" parent="1" source="a0" target="ad">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae1" style="html=1;endArrow=block;endFill=1;strokeColor=#94a3b8;strokeWidth=1.5;exitX=1;exitY=0.15;entryX=0;entryY=0.5;" edge="1" parent="1" source="ad" target="a1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

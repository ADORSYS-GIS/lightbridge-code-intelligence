        <mxCell id="fe2" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#94a3b8;strokeWidth=1.5;fontColor=#e2e8f0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#000000;exitX=1;exitY=0.7;entryX=1;entryY=0.5;" edge="1" parent="1" source="fd" target="f2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="2 - Review Flow" id="review-flow">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1250" math="0" shadow="0" background="#000000">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="titleA" value="A. From webhook to review — does this repo need indexing first?" style="text;html=1;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#ffffff;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="55" width="800" height="28" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="GitHub webhook&#10;(PR opened / @mention)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="Task row created,&#10;Job dispatched" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="340" y="140" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ad" value="repo_has_index&#10;already true?" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="620" y="100" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="NO -- clone, index&#10;(semantic + structural),&#10;then review" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#94a3b8;fontColor=#cbd5e1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="980" y="40" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="YES -- skip indexing,&#10;go straight to review&#10;against the base index" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="980" y="180" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ae1" style="html=1;endArrow=block;endFill=1;strokeColor=#94a3b8;strokeWidth=1.5;" edge="1" parent="1" source="a1" target="a2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae2" style="html=1;endArrow=block;endFill=1;strokeColor=#94a3b8;strokeWidth=1.5;" edge="1" parent="1" source="a2" target="ad">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae3" value="NO" style="html=1;endArrow=block;endFill=1;strokeColor=#94a3b8;strokeWidth=1.5;fontColor=#e2e8f0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#000000;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="ad" target="a3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae4" value="YES" style="html=1;endArrow=block;endFill=1;strokeColor=#94a3b8;strokeWidth=1.5;fontColor=#e2e8f0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#000000;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="ad" target="a4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="titleB" value="B. Job hardening — is this task running untrusted code?" style="text;html=1;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#ffffff;align=left;" vertex="1" parent="1">
          <mxGeometry x="1500" y="55" width="650" height="28" as="geometry" />
        </mxCell>
        <mxCell id="bd" value="Is this an &quot;open&quot;&#10;task (runs generated&#10;or repo code)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1500" y="110" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="NO -- standard pod,&#10;normal credentials" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1860" y="95" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="YES -- read-only rootfs, all&#10;capabilities dropped, no SA&#10;token, one writable emptyDir" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1860" y="180" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="be1" value="NO" style="html=1;endArrow=block;endFill=1;strokeColor=#94a3b8;strokeWidth=1.5;fontColor=#e2e8f0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#000000;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="1" source="bd" target="b1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="be2" value="YES" style="html=1;endArrow=block;endFill=1;strokeColor=#94a3b8;strokeWidth=1.5;fontColor=#e2e8f0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#000000;exitX=1;exitY=0.75;entryX=0;entryY=0.5;" edge="1" parent="1" source="bd" target="b2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="titleF" value="C. What actually drives the review — OpenCode" style="text;html=1;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#ffffff;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="330" width="700" height="28" as="geometry" />

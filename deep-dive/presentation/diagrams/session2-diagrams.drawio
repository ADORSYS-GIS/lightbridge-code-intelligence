<mxCell id="n101" value="A. Postgres — relational" style="text;html=1;fontFamily=Helvetica;fontSize=17;fontStyle=1;fontColor=#ffffff;align=left;" vertex="1" parent="1">
  <mxGeometry x="60" y="50" width="900" height="28" as="geometry" />
</mxCell>
<mxCell id="n102" value="repositories&#10;One connected repo. Owner/name/platform, approval status, task_count." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=11;strokeWidth=2;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
  <mxGeometry x="60" y="120" width="250" height="72" as="geometry" />
</mxCell>
<mxCell id="n103" value="repo_index&#10;Legacy per-branch index run record (status/timing)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
  <mxGeometry x="390" y="120" width="230" height="64" as="geometry" />
</mxCell>
<mxCell id="n104" value="index_snapshots&#10;One row per (repo, commit) that FINISHED indexing. Retrieval only pins to a row here." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
  <mxGeometry x="390" y="210" width="230" height="64" as="geometry" />
</mxCell>
<mxCell id="n105" value="repo_settings&#10;Operator override layer for review behaviour (push strategy, dedup scope, ...). 1:1 with repo." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
  <mxGeometry x="390" y="300" width="230" height="64" as="geometry" />
</mxCell>
<mxCell id="n106" value="repo_model_overrides&#10;Operator-pinned model for one repo. 1:1, absent = inherit from org/global." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
  <mxGeometry x="390" y="390" width="230" height="64" as="geometry" />
</mxCell>

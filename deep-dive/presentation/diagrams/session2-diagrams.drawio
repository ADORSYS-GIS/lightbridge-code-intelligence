  <mxGeometry relative="1" as="geometry" />
</mxCell>
<mxCell id="n125" value="a2a_tasks&#10;A2A taskId -&gt; our tasks row (NULL if rejected at the gate). Optimistic-concurrency version column." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=11;strokeWidth=2;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
  <mxGeometry x="1050" y="570" width="260" height="72" as="geometry" />
</mxCell>
<mxCell id="n126" value="underlying_task_id (nullable)" style="html=1;endArrow=block;endFill=1;strokeColor=#94a3b8;strokeWidth=1.2;fontColor=#e2e8f0;fontFamily=Helvetica;fontSize=9;labelBackgroundColor=#000000;" edge="1" parent="1" source="n125" target="n113">
  <mxGeometry relative="1" as="geometry" />
</mxCell>
<mxCell id="n127" value="a2a_task_events&#10;Append-only, gap-free per-task event log (status/artifact updates) — the streaming source of truth." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
  <mxGeometry x="1360" y="480" width="230" height="64" as="geometry" />
</mxCell>
<mxCell id="n128" value="a2a_push_configs&#10;Registered push-notification webhooks + delivery cursor into a2a_task_events. SSRF-validated URL." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffffff;fontColor=#ffffff;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
  <mxGeometry x="1360" y="570" width="230" height="64" as="geometry" />
</mxCell>
